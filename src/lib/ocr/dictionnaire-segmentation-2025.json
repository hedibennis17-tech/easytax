{
  "meta": {
    "title": "Dictionnaire de segmentation OCR — feuillets et lignes fiscales canadiennes",
    "version": "2025.1.0",
    "tax_year": 2025,
    "created": "2026-10-05",
    "source": "declaration-pancanadienne-2025.html + extracteurs EasyTax (t4.ts)",
    "purpose": "Segmentation OCR : identifier le feuillet en cours de traitement, localiser ses cases dans le texte extrait, et mapper chaque case vers les lignes T1/TP-1. À croiser avec le catalogue de classification pan-canadien v2 (qui dit QUEL document c'est ; ce dictionnaire dit CE QU'IL CONTIENT et OÙ ÇA VA).",
    "usage": [
      "1. Classifier le document avec le catalogue v2 (anchors).",
      "2. Charger l'entrée 'slips' correspondante de ce dictionnaire.",
      "3. Pour chaque case : chercher keywords_fr/keywords_en + code dans le texte OCR.",
      "4. Extraire le montant adjacent (pattern money du dictionnaire).",
      "5. Mapper vers t1_line / tp1_line pour alimenter le calcul."
    ]
  },
  "money_patterns": {
    "fr": "([0-9]{1,3}(?:[\\s,\\u00a0][0-9]{3})*(?:[.,][0-9]{2})(?!\\d)|[0-9]+[.,][0-9]{2}(?!\\d))",
    "note": "Montant FR « 7 201,32 » ou EN « 7,201.32 ». Le (?!\\d) empêche d'absorber un chiffre de la colonne suivante (ex. « 024 048 » → pas de montant).",
    "table_row": "\\b20\\d{2}\\s*\\|\\s*{money}",
    "table_row_note": "Document AI rend les tableaux « année | montant | NAS | code » : ex. « 2025 | 7 201,32 | 314 003 062 | 0 ».",
    "normalize": "Supprimer les espaces, convertir la virgule décimale en point si aucun point présent : « 7 201,32 » → « 7201.32 »."
  },
