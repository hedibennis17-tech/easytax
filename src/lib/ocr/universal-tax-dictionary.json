  "identityExtraction": {
    "employerName": {
      "patternsFr": ["Nom du payeur","Nom de l'employeur","Nom et adresse de l'organisme","Nom de l'émetteur"],
      "patternsEn": ["Payer's name","Employer's name","Issuer name"],
      "type": "text",
      "maxLength": 100
    },
    "employerBN": {
      "patternsFr": ["Numéro de compte de programme","Numéro d'entreprise"],
      "patternsEn": ["Business number","Program account number","BN"],
      "type": "business_number",
      "format": "^\\d{9}[A-Z]{2}\\d{4}$"
    },
    "recipientName": {
      "patternsFr": ["Nom de famille","Prénom","Nom du bénéficiaire"],
      "patternsEn": ["Last name","First name","Recipient name"],
      "type": "text",
      "maxLength": 100
    },
    "recipientSIN": {
      "patternsFr": ["Numéro d'assurance sociale","NAS"],
      "patternsEn": ["Social insurance number","SIN"],
      "type": "sin",
      "format": "^\\d{3}[\\s\\-]?\\d{3}[\\s\\-]?\\d{3}$"
    },
    "taxYear": {
      "patternsFr": ["Année","Année d'imposition"],
      "patternsEn": ["Year","Tax year"],
      "type": "year",
      "format": "^20\\d{2}$"
    }
  },

  "ocrRules": {
    "numeric": {
      "commonConfusions": { "O":"0","I":"1","l":"1","S":"5","B":"8","Z":"2","G":"6" },
      "formats": ["52340.25","52,340.25","52 340,25","52 340.25","52,340 25","$52,340.25"],
      "ambiguousFormats": ["52 340 25"],
      "ambiguousAction": "review"
    },
    "rejectPatterns": [
      { "pattern": "[.,]\\d{3,}", "reason": "more_than_2_decimals" },
      { "pattern": "^\\d{1,4}$", "reason": "looks_like_box_code_not_amount" }
    ],
    "minimumAmount": 0.01,
    "maximumAmount": 9999999.99
  },

  "confidenceRules": {
    "AUTO_ACCEPT": { "min": 0.95, "max": 1.0, "action": "auto_accept" },
    "ACCEPT_OPTIONAL_REVIEW": { "min": 0.85, "max": 0.949, "action": "accept_with_flag" },
